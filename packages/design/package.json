{
  "name": "@healthkoins/design",
  "version": "1.0.0",
  "description": "Global design system for all healthkoins apps",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./icons": "./src/icons.ts",
    "./logo": "./src/logo/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./next-theme-provider": "./src/theme/next-theme-provider.tsx",
    "./next-theme-toggle": "./src/theme/next-theme-toggle.tsx"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.71.0",
    "next-themes": "0.4.6",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  }
}
