{
  "name": "@healthkoins/config",
  "version": "1.0.0",
  "private": true,
  "description": "Shared build/framework configuration presets for healthkoins applications and services.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./nextConfig": {
      "types": "./dist/nextConfig.d.mts",
      "default": "./dist/nextConfig.mjs"
    },
    "./DataFAQ": {
      "types": "./dist/DataFAQ.d.mts",
      "default": "./dist/DataFAQ.mjs"
    },
    "./DataPrivacyPolicy": {
      "types": "./dist/DataPrivacyPolicy.d.mts",
      "default": "./dist/DataPrivacyPolicy.mjs"
    },
    "./DataTermsOfUse": {
      "types": "./dist/DataTermsOfUse.d.mts",
      "default": "./dist/DataTermsOfUse.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "next": "16.4.6"
  },
  "devDependencies": {
    "next": "16.4.6",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  }
}
